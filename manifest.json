{
  "manifest_version": 3,
  "name": "SEEge",
  "version": "0.1.1",
  "description": "Class attendance and engagement monitor for Google Meet.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}